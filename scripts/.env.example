# DSA — local importer configuration. Copy to scripts/.env and fill in.
# scripts/.env is gitignored: it must never be committed, shared or deployed.
# Step by step: see IMPORT_GUIDE.md.

# Supabase → Project Settings → API (Data API) → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → service_role (secret key).
# It bypasses every security policy. Local scripts only: never in Vercel, in an app, or in git.
SUPABASE_SERVICE_ROLE_KEY=

# Private salt mixed into every node, edge and character id (GRAPH_SPECIFICATION.md §7).
# Generate it ONCE:  node -e "console.log(crypto.randomUUID())"
# Then keep it forever: changing it changes every id in the database.
DSA_ID_SALT=
