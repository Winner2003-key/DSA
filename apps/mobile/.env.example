# Copy this file to apps/mobile/.env and fill in the real values.
# Every variable the app reads at runtime must start with EXPO_PUBLIC_.
# These two values are public by design (the anon key is protected by RLS);
# never put SUPABASE_SERVICE_ROLE_KEY here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Graph played by the app. "livre" is the real book, "mini" the test graph.
EXPO_PUBLIC_DSA_GRAPH_SLUG=livre

# 1 = play entirely on the device against packages/core + the mini graph fixture,
# with no Supabase at all. For development and demos only; shows a visible badge.
EXPO_PUBLIC_DSA_OFFLINE=0
