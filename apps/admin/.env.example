# DSA admin — copy to .env.local and fill in.
# Project Settings → Data API (URL) and API Keys (anon / publishable key) in the Supabase dashboard.
# Only these two public variables are ever needed. NEVER put the service role key here or in Vercel.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Development only: serve packages/core/fixtures/mini-graph.json from memory instead of Supabase.
# Sign-in and the admin gate are bypassed. Never set this in Vercel.
# NEXT_PUBLIC_DSA_MOCK=1
